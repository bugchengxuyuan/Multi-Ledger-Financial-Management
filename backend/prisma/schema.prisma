// V1 Prisma Schema - 多账本财务管理系统
// 基于业界最佳实践简化设计（参考 Firefly III、MoneyNote）

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// 账本表 - 核心实体
// 参考: MoneyNote的AccountBook + Firefly III的Account
// ============================================================================
model AccountBook {
  id              String   @id @default(uuid())
  name            String   @unique @db.VarChar(100) // 账本名称（唯一）

  // 账本类型（只是标签，不影响功能）
  type            String   @default("personal") @db.VarChar(20) // 'personal' | 'business' | 'partner'

  // 余额相关（Firefly III实践）
  openingBalance  Decimal  @default(0) @db.Decimal(15, 2) // 期初余额
  currentBalance  Decimal  @default(0) @db.Decimal(15, 2) // 当前余额（自动计算）

  // 显示相关（MoneyNote实践）
  color           String   @default("#1890ff") @db.VarChar(20) // 账本颜色
  icon            String   @default("book") @db.VarChar(50)    // 账本图标

  // 系统相关
  isDefault       Boolean  @default(false) // 是否默认账本（唯一）
  description     String?  @db.Text        // 账本描述

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 关系
  transactions    Transaction[]
  tags            Tag[]
  balanceLogs     BalanceLog[]

  @@index([type])
  @@index([isDefault])
}

// ============================================================================
// 交易表 - 核心实体
// 参考: Firefly III的Transaction简化版
// ============================================================================
model Transaction {
  id              String   @id @default(uuid())
  accountBookId   String                          // 关联账本（必填）

  // 交易基本信息
  type            String   @db.VarChar(20)       // 'income' | 'expense'
  amount          Decimal  @db.Decimal(15, 2)    // 金额（必须>0）
  date            DateTime @db.Date              // 交易日期

  // 分类标签（必选）
  categoryTagId   String                          // 分类标签ID

  // 描述信息
  description     String?  @db.VarChar(500)      // 交易描述
  notes           String?  @db.Text              // 备注

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 关系
  accountBook     AccountBook     @relation(fields: [accountBookId], references: [id], onDelete: Cascade)
  categoryTag     Tag             @relation("TransactionCategory", fields: [categoryTagId], references: [id], onDelete: Restrict)
  labelTags       TransactionTag[] // 普通标签（多对多）
  balanceLogs     BalanceLog[]

  // 单字段索引
  @@index([accountBookId])
  @@index([type])
  @@index([date])
  @@index([categoryTagId])

  // 复合索引 - 优化常用查询
  @@index([accountBookId, date])
  @@index([accountBookId, type, date])
  @@index([categoryTagId, date])
}

// ============================================================================
// 标签表 - 灵活的分类系统
// 参考: Firefly III的Category + Tag设计
// ============================================================================
model Tag {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(50)       // 标签名称

  // 标签类型（Firefly III实践）
  tagType         String   @db.VarChar(20)       // 'category' | 'label'

  // 作用域（MoneyNote + 创新）
  scope           String   @default("global") @db.VarChar(20) // 'global' | 'account_book'
  accountBookId   String?                         // 账本专属标签的所属账本

  // 显示相关
  color           String   @default("#666666") @db.VarChar(20)
  icon            String?  @db.VarChar(50)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 关系
  accountBook         AccountBook?     @relation(fields: [accountBookId], references: [id], onDelete: Cascade)
  categoryTransactions Transaction[]   @relation("TransactionCategory") // 作为分类标签的交易
  labelTransactions   TransactionTag[] // 作为普通标签的交易

  // 唯一约束：同一范围内标签名不重复
  @@unique([name, scope, accountBookId])

  @@index([tagType])
  @@index([scope])
  @@index([accountBookId])
}

// ============================================================================
// 交易-标签关联表 - 多对多关系
// 用于Label类型标签与交易的关联
// ============================================================================
model TransactionTag {
  id              String   @id @default(uuid())
  transactionId   String
  tagId           String

  createdAt       DateTime @default(now())

  // 关系
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag             Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  // 唯一约束（同一交易不能重复添加同一标签）
  @@unique([transactionId, tagId])

  @@index([transactionId])
  @@index([tagId])
}

// ============================================================================
// 余额变动日志表 - 审计追踪
// ============================================================================
model BalanceLog {
  id              String   @id @default(uuid())
  accountBookId   String

  changeType      String   @db.VarChar(20) // 'income' | 'expense' | 'manual_adjust' | 'initial'
  amountBefore    Decimal  @db.Decimal(15, 2) // 变更前余额
  amountAfter     Decimal  @db.Decimal(15, 2) // 变更后余额
  changeAmount    Decimal  @db.Decimal(15, 2) // 变更金额

  note            String?  @db.Text
  transactionId   String?                     // 关联交易ID

  createdAt       DateTime @default(now())

  // 关系
  accountBook     AccountBook  @relation(fields: [accountBookId], references: [id], onDelete: Cascade)
  transaction     Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([accountBookId])
  @@index([createdAt])
  @@index([changeType])
  @@index([transactionId])
}
