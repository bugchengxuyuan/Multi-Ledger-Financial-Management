generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccountBook {
  id             String          @id @default(uuid())
  name           String          @db.VarChar(100)
  description    String?
  icon           String          @db.VarChar(10)
  color          String          @db.VarChar(20)
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  balanceMode    String          @default("mixed") @db.VarChar(20)
  currentBalance Decimal         @default(0) @db.Decimal(12, 2)
  initialBalance Decimal         @default(0) @db.Decimal(12, 2)
  config         Json?
  features       Json?
  type           String          @default("personal") @db.VarChar(50)
  balanceLogs    BalanceLog[]
  Budget         Budget[]
  CreditAccount  CreditAccount[]
  Expense        Expense[]
  Income         Income[]
  Investment     Investment[]
  tags           Tag[]
  transactions   Transaction[]

  @@index([isDefault])
}

model Transaction {
  id                 String         @id @default(uuid())
  type               String         @db.VarChar(20)
  subType            String?        @db.VarChar(50)
  date               DateTime       @db.Date
  categoryTagId      String
  amount             Decimal        @db.Decimal(12, 2)
  description        String         @db.VarChar(255)
  accountBookId      String?
  note               String?
  needsReimbursement Boolean        @default(false)
  labelTagIds        String[]
  receiptPhoto       String?
  location           String?
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  BalanceLog         BalanceLog[]
  Reimbursement      Reimbursement?
  accountBook        AccountBook?   @relation(fields: [accountBookId], references: [id])
  categoryTag        Tag            @relation("TransactionCategory", fields: [categoryTagId], references: [id])

  @@index([accountBookId])
  @@index([type])
  @@index([date])
  @@index([categoryTagId])
}

model Tag {
  id                   String             @id @default(uuid())
  name                 String             @unique @db.VarChar(50)
  color                String             @db.VarChar(20)
  icon                 String?            @db.VarChar(10)
  count                Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  type                 String             @db.VarChar(20)
  accountBookId        String?
  applicableTypes      String[]           @default([])
  Budget               Budget[]
  Expense              Expense[]
  ExpenseTemplate      ExpenseTemplate[]
  Income               Income[]
  RecurringExpense     RecurringExpense[]
  accountBook          AccountBook?       @relation(fields: [accountBookId], references: [id])
  categoryTransactions Transaction[]      @relation("TransactionCategory")

  @@index([accountBookId])
  @@index([type])
}

model BalanceLog {
  id                   String       @id @default(uuid())
  accountBookId        String
  changeType           String       @db.VarChar(20)
  amountBefore         Decimal      @db.Decimal(12, 2)
  amountAfter          Decimal      @db.Decimal(12, 2)
  changeAmount         Decimal      @db.Decimal(12, 2)
  note                 String?
  relatedIncomeId      String?
  relatedExpenseId     String?
  createdAt            DateTime     @default(now())
  relatedTransactionId String?
  accountBook          AccountBook  @relation(fields: [accountBookId], references: [id], onDelete: Cascade)
  Transaction          Transaction? @relation(fields: [relatedTransactionId], references: [id])

  @@index([accountBookId])
  @@index([createdAt])
  @@index([changeType])
  @@index([relatedTransactionId])
}

model Budget {
  id               String       @id
  amount           Decimal      @db.Decimal(10, 2)
  period           String       @db.VarChar(20)
  startDate        DateTime     @db.Date
  accountBookId    String?
  warningThreshold Int          @default(80)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime
  categoryTagId    String
  AccountBook      AccountBook? @relation(fields: [accountBookId], references: [id])
  Tag              Tag          @relation(fields: [categoryTagId], references: [id])

  @@index([categoryTagId])
  @@index([period])
}

model Config {
  id                   String   @id @default("main")
  jiebeiTotal          Decimal  @db.Decimal(10, 2)
  salary               Decimal  @db.Decimal(10, 2)
  salaryDate           String   @db.VarChar(20)
  jiebeiDueDate        String   @db.VarChar(20)
  investmentCapital    Decimal  @db.Decimal(12, 2)
  currentAccountBookId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime
}

model CreditAccount {
  id               String          @id
  name             String          @db.VarChar(100)
  provider         String          @db.VarChar(100)
  type             String          @db.VarChar(50)
  currentDebt      Decimal         @default(0) @db.Decimal(12, 2)
  creditLimit      Decimal?        @db.Decimal(12, 2)
  repaymentDay     Int
  monthlyRepayment Decimal?        @db.Decimal(12, 2)
  status           String          @default("active")
  accountBookId    String
  note             String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  AccountBook      AccountBook     @relation(fields: [accountBookId], references: [id], onDelete: Cascade)
  DebtChangeLog    DebtChangeLog[]

  @@index([accountBookId])
  @@index([status])
  @@index([type])
}

model DebtChangeLog {
  id               String        @id
  creditAccountId  String
  changeType       String
  amountBefore     Decimal       @db.Decimal(12, 2)
  amountAfter      Decimal       @db.Decimal(12, 2)
  changeAmount     Decimal       @db.Decimal(12, 2)
  note             String?
  relatedExpenseId String?
  createdAt        DateTime      @default(now())
  CreditAccount    CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  @@index([changeType])
  @@index([createdAt])
  @@index([creditAccountId])
}

model Expense {
  id                 String         @id
  date               DateTime       @db.Date
  amount             Decimal        @db.Decimal(10, 2)
  description        String         @db.VarChar(255)
  needsReimbursement Boolean        @default(false)
  accountBookId      String?
  note               String?
  receiptPhoto       String?
  location           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime
  categoryTagId      String
  labelTagIds        String[]
  AccountBook        AccountBook?   @relation(fields: [accountBookId], references: [id])
  Tag                Tag            @relation(fields: [categoryTagId], references: [id])
  Reimbursement      Reimbursement?

  @@index([accountBookId])
  @@index([categoryTagId])
  @@index([date])
}

model ExpenseTemplate {
  id                 String   @id
  name               String   @db.VarChar(100)
  amount             Decimal  @db.Decimal(10, 2)
  description        String   @db.VarChar(255)
  needsReimbursement Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  categoryTagId      String
  labelTagIds        String[]
  Tag                Tag      @relation(fields: [categoryTagId], references: [id])

  @@index([categoryTagId])
}

model Income {
  id            String       @id
  date          DateTime     @db.Date
  categoryTagId String
  amount        Decimal      @db.Decimal(10, 2)
  description   String       @db.VarChar(255)
  accountBookId String?
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  AccountBook   AccountBook? @relation(fields: [accountBookId], references: [id])
  Tag           Tag          @relation(fields: [categoryTagId], references: [id])

  @@index([accountBookId])
  @@index([categoryTagId])
  @@index([date])
}

model Investment {
  id            String       @id
  name          String       @db.VarChar(255)
  type          String       @db.VarChar(50)
  amount        Decimal      @db.Decimal(12, 2)
  status        String       @default("holding")
  note          String?
  purchaseDate  DateTime     @db.Date
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  accountBookId String?
  AccountBook   AccountBook? @relation(fields: [accountBookId], references: [id], onDelete: Cascade)

  @@index([accountBookId])
  @@index([status])
  @@index([type])
}

model RecurringExpense {
  id            String    @id
  name          String    @db.VarChar(100)
  amount        Decimal   @db.Decimal(10, 2)
  description   String    @db.VarChar(255)
  frequency     String    @db.VarChar(20)
  dayOfWeek     Int?
  dayOfMonth    Int?
  monthOfYear   Int?
  startDate     DateTime  @db.Date
  endDate       DateTime? @db.Date
  lastExecuted  DateTime?
  enabled       Boolean   @default(true)
  autoCreate    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  categoryTagId String
  Tag           Tag       @relation(fields: [categoryTagId], references: [id])

  @@index([categoryTagId])
  @@index([enabled])
}

model Reimbursement {
  id             String       @id
  date           DateTime     @db.Date
  item           String       @db.VarChar(255)
  amount         Decimal      @db.Decimal(10, 2)
  note           String
  status         String       @default("pending")
  reimbursedDate DateTime?
  expenseId      String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  transactionId  String?      @unique
  Expense        Expense?     @relation(fields: [expenseId], references: [id])
  Transaction    Transaction? @relation(fields: [transactionId], references: [id])

  @@index([status])
}
